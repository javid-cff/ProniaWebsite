@{
    ViewData["Title"] = "Email Təsdiqi";
}

<div style="display:flex; justify-content:center; align-items:center; height:80vh; font-family:Segoe UI, sans-serif; background-color:#f5f6fa;">
    <div style="background:white; padding:40px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.1); text-align:center; max-width:450px;">

        <div style="font-size:50px; color:#4cd137; margin-bottom:20px;">
            ✅
        </div>

        <h2 style="margin-bottom:15px; color:#2f3640;">Emailiniz təsdiqləndi!</h2>

        <p style="color:#718093; margin-bottom:30px;">
            Təşəkkür edirik. Artıq hesabınıza giriş edə bilərsiniz.
        </p>

        <a asp-controller="Account" asp-action="Login"
           style="text-decoration:none; background:#40739e; color:white; padding:12px 25px; border-radius:8px; font-weight:500; transition:0.3s;">
            Giriş Et
        </a>
    </div>
</div>
